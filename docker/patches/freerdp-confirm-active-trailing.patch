diff --git a/libfreerdp/core/capabilities.c b/libfreerdp/core/capabilities.c
index 0cf8489..efb0751 100644
--- a/libfreerdp/core/capabilities.c
+++ b/libfreerdp/core/capabilities.c
@@ -4777,6 +4777,15 @@ BOOL rdp_recv_confirm_active(rdpRdp* rdp, wStream* s, UINT16 pduLength)
 		settings->LargePointerFlag = 0;
 	}
 
+	/* Some clients (Jump Desktop) append bytes that are not covered by the announced
+	 * capability sets. Skip them instead of dropping the connection. */
+	const size_t trailing = Stream_GetRemainingLength(s);
+	if (trailing > 0)
+	{
+		WLog_Print(rdp->log, WLOG_WARN,
+		           "Confirm Active PDU has %" PRIuz " unparsed trailing bytes, ignoring", trailing);
+		Stream_Seek(s, trailing);
+	}
 	return tpkt_ensure_stream_consumed(rdp->log, s, pduLength);
 }
 
