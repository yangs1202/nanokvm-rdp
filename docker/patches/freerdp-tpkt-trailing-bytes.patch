diff --git a/libfreerdp/core/capabilities.c b/libfreerdp/core/capabilities.c
index 0cf8489..4a43826 100644
--- a/libfreerdp/core/capabilities.c
+++ b/libfreerdp/core/capabilities.c
@@ -4510,6 +4510,8 @@ static BOOL rdp_read_capability_sets(wLog* log, wStream* s, rdpSettings* setting
 
 		if (!rdp_read_capability_set_header(log, s, &length, &type))
 			goto fail;
+		WLog_Print(log, WLOG_WARN, "capability set type=%" PRIu16 " length=%" PRIu16
