diff --git a/libfreerdp/core/tpkt.c b/libfreerdp/core/tpkt.c
index 5d7beef..149537d 100644
--- a/libfreerdp/core/tpkt.c
+++ b/libfreerdp/core/tpkt.c
@@ -145,9 +145,19 @@ BOOL tpkt_ensure_stream_consumed_(wLog* log, wStream* s, size_t length, const ch
 	{
 		WLog_Print(log, WLOG_ERROR,
 		           "[%s] Received invalid TPKT header length %" PRIu16 ", %" PRIdz
-		           " bytes too long!",
+		           " bytes too long, ignoring",
 		           fkt, length, rem);
-		return FALSE;
+		/* Jump Desktop appends bytes that the PDU parsers do not account for.
+		 * Log them and skip instead of dropping the connection. */
+		{
+			char hex[3 * 64 + 1] = { 0 };
+			const BYTE* ptr = Stream_ConstPointer(s);
+			const size_t n = (rem < 64) ? rem : 64;
+			for (size_t i = 0; i < n; i++)
+				(void)snprintf(&hex[3 * i], 4, "%02X ", ptr[i]);
+			WLog_Print(log, WLOG_WARN, "[%s] skipped bytes: %s", fkt, hex);
+		}
+		Stream_Seek(s, rem);
 	}
 	return TRUE;
 }
