#!/bin/sh

APP_DIR=/root/nanokvm-rdp
DAEMON="$APP_DIR/nanokvm-rdp"
PIDFILE="$APP_DIR/nanokvm-rdp.pid"
LOGFILE="$APP_DIR/nanokvm-rdp.log"
CERT="$APP_DIR/cert.pem"
KEY="$APP_DIR/key.pem"
FOLDVNC_INIT=/etc/init.d/S99foldvnc

is_running() {
    [ -s "$PIDFILE" ] || return 1
    pid="$(cat "$PIDFILE" 2>/dev/null || true)"
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

ensure_certificate() {
    [ -s "$CERT" ] && [ -s "$KEY" ] && return 0
    umask 077
    /usr/bin/openssl req -x509 -newkey rsa:2048 -nodes -sha256 -days 3650 \
        -subj '/CN=NanoKVM-RDP' -keyout "$KEY" -out "$CERT"
}

start() {
    printf 'Starting NanoKVM RDP server: '
    [ -x "$DAEMON" ] || { echo "FAIL ($DAEMON missing)"; return 1; }
    ensure_certificate || { echo 'FAIL (certificate)'; return 1; }
    if is_running; then
        echo "OK (already running pid $(cat "$PIDFILE"))"
        return 0
    fi

    # libkvm.so owns the capture path. FoldVNC must not run concurrently.
    [ -x "$FOLDVNC_INIT" ] && "$FOLDVNC_INIT" stop
    export LD_LIBRARY_PATH=/kvmapp/server/dl_lib:/tmp/server/dl_lib
    nohup "$DAEMON" -listen 0.0.0.0:3389 -cert "$CERT" -key "$KEY" \
        >> "$LOGFILE" 2>&1 &
    echo $! > "$PIDFILE"
    sleep 1
    if is_running; then
        echo "OK (pid $(cat "$PIDFILE"))"
        return 0
    fi
    echo 'FAIL'
    tail -n 40 "$LOGFILE" 2>/dev/null || true
    return 1
}

stop() {
    printf 'Stopping NanoKVM RDP server: '
    if is_running; then
        kill "$(cat "$PIDFILE")" 2>/dev/null || true
        sleep 1
    fi
    if is_running; then
        kill -9 "$(cat "$PIDFILE")" 2>/dev/null || true
    fi
    rm -f "$PIDFILE"
    echo OK

    # Restore the existing remote-access path whenever RDP is stopped.
    [ -x "$FOLDVNC_INIT" ] && "$FOLDVNC_INIT" start
}

status() {
    if is_running; then
        echo "NanoKVM RDP server is running (pid $(cat "$PIDFILE"))"
    else
        echo 'NanoKVM RDP server is stopped'
        return 1
    fi
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    status) status ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
