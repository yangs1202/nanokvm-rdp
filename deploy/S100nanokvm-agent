#!/bin/sh

APP_DIR=/root/nanokvm-rdp
DAEMON="$APP_DIR/nanokvm-agent"
PIDFILE="$APP_DIR/nanokvm-agent.pid"
LOGFILE="$APP_DIR/nanokvm-agent.log"
GATEWAY=10.97.12.17
CONTROL_PORT=3390
VIDEO_PORT=5004
WIDTH=960
HEIGHT=540
BITRATE=3000
LEGACY_INIT=/etc/init.d/S100nanokvm-rdp
FOLDVNC_INIT=/etc/init.d/S99foldvnc

is_running() {
    [ -s "$PIDFILE" ] || return 1
    pid="$(cat "$PIDFILE" 2>/dev/null || true)"
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

start() {
    printf 'Starting NanoKVM gateway agent: '
    [ -x "$DAEMON" ] || { echo "FAIL ($DAEMON missing)"; return 1; }
    if is_running; then
        echo "OK (already running pid $(cat "$PIDFILE"))"
        return 0
    fi
    [ -x "$LEGACY_INIT" ] && "$LEGACY_INIT" stop
    [ -x "$FOLDVNC_INIT" ] && "$FOLDVNC_INIT" stop
    export LD_LIBRARY_PATH=/kvmapp/server/dl_lib:/tmp/server/dl_lib
    nohup "$DAEMON" -gateway "$GATEWAY" -control-port "$CONTROL_PORT" -video-port "$VIDEO_PORT" \
        -width "$WIDTH" -height "$HEIGHT" -bitrate "$BITRATE" >> "$LOGFILE" 2>&1 &
    echo $! > "$PIDFILE"
    sleep 1
    is_running && { echo "OK (pid $(cat "$PIDFILE"))"; return 0; }
    echo FAIL
    return 1
}

stop() {
    printf 'Stopping NanoKVM gateway agent: '
    if is_running; then
        kill "$(cat "$PIDFILE")" 2>/dev/null || true
        sleep 1
    fi
    is_running && kill -9 "$(cat "$PIDFILE")" 2>/dev/null || true
    rm -f "$PIDFILE"
    echo OK
    [ -x "$LEGACY_INIT" ] && "$LEGACY_INIT" start
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    status) is_running && echo "NanoKVM gateway agent is running" || exit 1 ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
