#!/bin/sh

APP_DIR=/root/nanokvm-rdp
DAEMON="$APP_DIR/nanokvm-agent"
PIDFILE="$APP_DIR/nanokvm-agent.pid"
LOGFILE="$APP_DIR/nanokvm-agent.log"
WATCHDOG="$APP_DIR/nanokvm-agent.watchdog.sh"
STOPFILE="$APP_DIR/nanokvm-agent.stop"
GATEWAY=nanokvm-gw.yangs.sh
CONTROL_PORT=3390
VIDEO_PORT=5004
WIDTH=1920
HEIGHT=1080
BITRATE=4000
LEGACY_PIDFILE="$APP_DIR/nanokvm-rdp.pid"

is_running() {
    [ -s "$PIDFILE" ] || return 1
    pid="$(cat "$PIDFILE" 2>/dev/null || true)"
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

stop_legacy_rdp() {
    [ -s "$LEGACY_PIDFILE" ] || return 0
    pid="$(cat "$LEGACY_PIDFILE" 2>/dev/null || true)"
    [ -n "$pid" ] && kill "$pid" 2>/dev/null || true
    rm -f "$LEGACY_PIDFILE"
}

write_watchdog() {
    cat > "$WATCHDOG" <<EOF
#!/bin/sh
export LD_LIBRARY_PATH=/kvmapp/server/dl_lib:/tmp/server/dl_lib
trap 'exit 0' INT TERM
while :; do
    [ -e "$STOPFILE" ] && exit 0
    "$DAEMON" -gateway "$GATEWAY" -control-port "$CONTROL_PORT" \\
        -video-port "$VIDEO_PORT" -width "$WIDTH" -height "$HEIGHT" \\
        -bitrate "$BITRATE" &
    child=\$!
    waited=0
    # 메인 스레드가 종료돼도 HID/캡처 스레드가 남으면 BusyBox wait가 반환하지 않는다.
    # 20초를 넘기면 프로세스 그룹을 정리해 깨끗한 상태로 재시작한다.
    while kill -0 "\$child" 2>/dev/null; do
        if [ -e "$STOPFILE" ]; then
            kill "\$child" 2>/dev/null || true
        fi
        if [ "\$waited" -ge 20 ]; then
            echo "nanokvm-agent pid=\$child 종료 대기 초과, 남은 스레드를 정리합니다"
            kill -9 "\$child" 2>/dev/null || true
            break
        fi
        sleep 1
        waited=\$((waited + 1))
    done
    wait "\$child"
    rc=\$?
    [ -e "$STOPFILE" ] && exit 0
    echo "nanokvm-agent exited rc=\$rc, 1초 후 watchdog 재시작"
    sleep 1
done
EOF
    chmod +x "$WATCHDOG"
}

start() {
    printf 'Starting NanoKVM gateway agent: '
    [ -x "$DAEMON" ] || { echo "FAIL ($DAEMON missing)"; return 1; }
    if is_running; then
        echo "OK (already running pid $(cat "$PIDFILE"))"
        return 0
    fi
    stop_legacy_rdp
    killall foldvnc-nanokvmd 2>/dev/null || true
    killall foldvnc-oledd 2>/dev/null || true
    killall kvm_system 2>/dev/null || true
    killall NanoKVM-Server 2>/dev/null || true
    rm -f "$STOPFILE"
    write_watchdog
    nohup "$WATCHDOG" >> "$LOGFILE" 2>&1 &
    echo $! > "$PIDFILE"
    sleep 1
    is_running && { echo "OK (pid $(cat "$PIDFILE"))"; return 0; }
    echo FAIL
    return 1
}

stop() {
    printf 'Stopping NanoKVM gateway agent: '
    touch "$STOPFILE"
    if is_running; then
        kill "$(cat "$PIDFILE")" 2>/dev/null || true
    fi
    killall nanokvm-agent 2>/dev/null || true
    sleep 1
    is_running && kill -9 "$(cat "$PIDFILE")" 2>/dev/null || true
    killall -9 nanokvm-agent 2>/dev/null || true
    rm -f "$PIDFILE"
    echo OK
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    status) is_running && echo "NanoKVM gateway agent is running" || exit 1 ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
